# =================================================================
#  faq-bot 环境变量模板（.env.example）
# =================================================================
#
#  用法：
#    1. 复制本文件为 .env：
#         cp .env.example .env        (macOS/Linux)
#         copy .env.example .env      (Windows)
#    2. 把下面每个 KEY 替换成你自己申请到的真实 KEY
#    3. !! .env 文件绝对不要提交到 git（已在 .gitignore 里屏蔽）
#
#  申请地址：
#    DeepSeek:  https://platform.deepseek.com/api_keys
#    和风天气:  https://dev.qweather.com/
#
#  前置依赖（必须装，否则 .env 不会被读取）：
#    pip install python-dotenv
#
#  填值注意：
#    - 不要加引号。写成  HEFENG_API_KEY=abc123
#      不要写成  HEFENG_API_KEY="abc123"
#    - 等号两边不要有空格
#    - 改完必须重启 Python / Streamlit 进程才生效
# =================================================================

# ---- DeepSeek（LLM 兜底）----
# 个人开发者注册即送额度，deepseek-chat 输入 ¥1/M tokens、输出 ¥2/M tokens
DEEPSEEK_API_KEY=

# ---- 和风天气（实时查询）----
# 个人开发者免费 1000 次/天。留空 → 天气问题降级到固定话术
HEFENG_API_KEY=

# !! 关键：和风的 API Host 是**每个账号单独分配**的，不一定是默认的
#    devapi.qweather.com。用错 host 会返回：
#        403 {"title":"Invalid Host","detail":"An invalid or unauthorized API Host."}
#    请到 https://console.qweather.com/setting/ 复制你自己的 API Host 填到这里。
#
# !! 两个极易踩的坑（2026-09-08 Docker 联调实测）：
#    1. 自定义域名前缀是控制台给的（形如 mc3byj5bbc），**不是** API key 的前 8 位。
#       填错时不会返回和风标准的 problem+json，而是「Content-Length: 0 的裸 403」，
#       极易误判成网络问题。判断办法：不带 key 直接请求，若同样裸 403 → host 错了。
#    2. 自定义域名用户，天气和城市查询**共用同一个 host**，只有 path 不同：
#         weather → {BASE_URL}/v7/weather/now
#         geo     → {BASE_URL}/geo/v2/city/lookup
#       代码里 geo 拼的是 "{HEFENG_GEO_URL}/v2/city/lookup"，
#       所以自定义域名下 GEO_URL 必须写成 "...re.qweatherapi.com/geo"（带 /geo）。
#       只有用官方 devapi 的账号才写 https://geoapi.qweather.com。
# HEFENG_BASE_URL=https://你的专属host.re.qweatherapi.com
# HEFENG_GEO_URL=https://你的专属host.re.qweatherapi.com/geo

# ---- HuggingFace（可选，仅当你切回官方源时用）----
# HF_ENDPOINT=https://hf-mirror.com
# HF_HOME=C:\Users\你的用户名\.cache\huggingface
# HF_HUB_OFFLINE=1


# =================================================================
#  W2 安全层（可选，强烈推荐开启）
# =================================================================
# 默认值都已写在 config.py 里，这里只是示例。
# 生产部署必须把 SECURITY_ENABLED 设为 True（默认就是 True）。

# ---- 总开关 ----
# SECURITY_ENABLED=true

# ---- W2.1 PII 脱敏 ----
# 替换 query 里的手机号 / 身份证 / 邮箱 / 银行卡 / IP / URL
# 喂给 LLM 之前自动替换为占位符
# REDACTION_ENABLED=true

# ---- W2.2 Prompt injection 检测 ----
# 拦截"忽略之前的指令"、"角色劫持"、"提示词泄露"、模型控制符
# INJECTION_ENABLED=true

# ---- W2.3 令牌桶限流 ----
# IP 维度：30 突发，0.5 个/秒（平均 1 次/2 秒）
# RATE_LIMIT_IP_CAPACITY=30
# RATE_LIMIT_IP_REFILL=0.5
# user_id 维度：60 突发，1.0 个/秒（平均 1 次/秒）
# RATE_LIMIT_USER_CAPACITY=60
# RATE_LIMIT_USER_REFILL=1.0

# ---- W2.4 成本熔断 ----
# 1 小时窗口内最多调 LLM 500 次 / 累计 10 元估算成本
# BUDGET_WINDOW_SEC=3600
# BUDGET_MAX_CALLS=500
# BUDGET_MAX_COST_CNY=10.0
# BUDGET_AVG_COST_CNY=0.01